# Web Server
HOST=0.0.0.0
PORT=5173
PUBLIC_URL=http://raspberrypi.local:5173

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=system_reset
WEBADMIN_COLLECTION=sysreset

# PostgreSQL Connection (Optional: Keep-Alive pings for Aiven, Neon, Supabase, Render, etc.)
postgresql_url=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
postgresql_db=defaultdb

# MySQL Connection (Optional: Keep-Alive pings for Aiven, PlanetScale, TiDB, Clever Cloud, etc.)
mysql_url=mysql://<user>:<password>@<host>:<port>/<database>
mysql_db=mysql

# Database SSL Certificate Verification (default is true; set false ONLY for self-signed development certs)
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional Custom CA Certificate Path (e.g., ./ca.pem or /etc/ssl/certs/db-ca.pem)
# DB_SSL_CA_PATH=./ca.pem

# JWT Authentication (Required: minimum 16 random characters, e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_random_key_min_16_chars_here

# Initial Admin Credentials (Do NOT use default admin/admin123456)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password_min_12_chars

# Secret Token for Cron Keep Alive Webhook Triggers (Sent via header: "x-cron-secret")
CRON_SECRET=your_custom_cron_secret_trigger_token

# Telegram Bot Integration for Keep-Alive Notifications & Remote Control
telegram_bot=your_telegram_bot_token_from_botfather

# Telegram Webhook Secret Token (Sent by Telegram via header "X-Telegram-Bot-Api-Secret-Token")
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here

# Local HTTPS on Raspberry Pi / Local Network (Optional: enables encrypted HTTPS on port 5173/custom port)
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem
